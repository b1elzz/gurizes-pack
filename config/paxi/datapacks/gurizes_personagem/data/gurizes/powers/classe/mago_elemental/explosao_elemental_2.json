{
  "type": "origins:active_self",
  "name": "Explosão Maior (II)",
  "description": "§o§7A mesma magia, agora com mais ira.§r\nApós o porteiro do Ato II, a Explosão Elemental sobe para o nível 5.",
  "cooldown": 400,
  "hud_render": {
    "should_render": true
  },
  "key": {
    "key": "key.origins.primary_active",
    "continuous": false
  },
  "entity_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:if_else",
        "condition": {
          "type": "origins:scoreboard",
          "objective": "gurizes.elemento",
          "comparison": "==",
          "compare_to": 1
        },
        "if_action": {
          "type": "origins:execute_command",
          "command": "cast @s irons_spellbooks:cone_of_cold 5"
        },
        "else_action": {
          "type": "origins:if_else",
          "condition": {
            "type": "origins:scoreboard",
            "objective": "gurizes.elemento",
            "comparison": "==",
            "compare_to": 2
          },
          "if_action": {
            "type": "origins:execute_command",
            "command": "cast @s irons_spellbooks:chain_lightning 5"
          },
          "else_action": {
            "type": "origins:execute_command",
            "command": "cast @s irons_spellbooks:fireball 5"
          }
        }
      },
      {
        "type": "origins:execute_command",
        "command": "advancement grant @s only gurizes:interno/habilidade_mago_elemental"
      }
    ]
  },
  "condition": {
    "type": "origins:advancement",
    "advancement": "gurizes:campanha/ato_2_vencido"
  }
}
